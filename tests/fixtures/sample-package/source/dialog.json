      {
        "id": "p4",
        "speaker": "user",
        "text": "Sami-sami Bu, nyuwun pamit.",
        "translation": "Sama-sama Bu, permisi.",
        "audio": "audio/dialog-start.opus",
        "next": "p5"
      },
      {
        "id": "p5",
        "speaker": "vendor",
        "text": "Nggih mangga, benjing mampir malih.",
        "translation": "Iya silakan, besok mampir lagi.",
        "audio": "audio/dialog-start.opus",
        "next": "end"
      }
