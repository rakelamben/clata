    "title": "Menyapa Tetangga",
    "interlocutor": "neighbor",
    "register": "netral",
    "unit_id": "unit-1",
    "contextDescription": "Menyapa dan bertukar kabar singkat dengan tetangga di pagi hari.",
    "partner": "Tetangga",
    "userRole": "Warga / Pengunjung",
    "avatar": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?crop=faces&fit=crop&h=160&w=160&q=80",
    "target_word_ids": [
      "kata-sugeng",
      "kata-enjing"
    ],
    "maxNewWords": 2,
    "nodes": [
      {
        "id": "n0",
        "speaker": "user",
        "text": "Sugeng enjing, Pak.",
        "translation": "Selamat pagi, Pak.",
        "audio": "audio/dialog-start.opus",
        "choices": [
          {
            "text": "Sugeng enjing, Pak.",
            "translation": "Selamat pagi, Pak.",
            "quality": "pas",
            "type": "register",
            "next": "n1",
            "audio": "audio/dialog-start.opus"
          },
          {
            "text": "Sugeng dalu, Pak.",
            "translation": "Selamat malam, Pak.",
            "quality": "kurang-pas",
            "type": "register",
            "next": "n1",
            "audio": "audio/dialog-start.opus"
          }
        ],
        "next": "n1"
      },
      {
        "id": "n1",
        "speaker": "neighbor",
        "text": "Sugeng enjing. Nembe badhe tindak pundi?",
        "translation": "Selamat pagi. Mau pergi ke mana?",
        "audio": "audio/dialog-start.opus",
        "choices": [
          {
            "text": "Badhe tindak dhateng peken, Pak.",
            "translation": "Mau pergi ke pasar, Pak.",
            "quality": "pas",
            "type": "comprehension",
            "next": "n2",
            "audio": "audio/dialog-start.opus"
          },
          {
            "text": "Kula badhe sare sakniki.",
            "translation": "Saya mau tidur sekarang.",
            "quality": "tidak-nyambung",
            "type": "comprehension",
            "next": "n1",
            "repair": {
              "text": "Ngapunten, mboten nyambung kalih situasi enjing.",
              "translation": "Maaf, kurang sesuai konteks jalan pagi.",
              "audio": "audio/dialog-start.opus"
            },
            "audio": "audio/dialog-start.opus"
          }
        ],
        "next": "n2"
      },
      {
        "id": "n2",
        "speaker": "user",
        "text": "Kula badhe mundhut sayur rumiyin.",
        "translation": "Saya mau beli sayur dulu.",
        "audio": "audio/dialog-start.opus",
        "next": "n3"
      },
      {
        "id": "n3",
        "speaker": "neighbor",
        "text": "O nggih, mangga dipun lajengaken.",
        "translation": "O iya, silakan dilanjutkan.",
        "audio": "audio/dialog-start.opus",
        "next": "n4"
      },
      {
        "id": "n4",
        "speaker": "user",
        "text": "Matur nuwun, Pak. Nyuwun pamit.",
        "translation": "Terima kasih, Pak. Permisi.",
        "audio": "audio/dialog-start.opus",
        "next": "n5"
      },
      {
        "id": "n5",
        "speaker": "neighbor",
        "text": "Nggih, ngatos-atos wonten margi.",
        "translation": "Iya, hati-hati di jalan.",
        "audio": "audio/dialog-start.opus",
        "next": "end"
      }
    ],
    "endings": [
      {
        "id": "end-pas",
        "quality": "pas",
        "feedback": "Sapaanmu dengan tetangga sangat santun dan pas."
      },
      {
        "id": "end-kurang-pas",
        "quality": "kurang-pas",
        "feedback": "Percakapan selesai, namun pilihan sapaanmu terasa kurang pas dan agak canggung untuk suasana pagi dengan tetangga."
      }
    ],
    "status": "poc"
  },
