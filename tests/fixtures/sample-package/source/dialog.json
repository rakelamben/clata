            "type": "comprehension",
            "next": "p1",
            "repair": {
              "text": "Kok siram? Badhe tumbas lombok menapa mboten?",
              "translation": "Kok mandi? Mau beli cabai apa tidak?",
              "audio": "audio/dialog-start.opus"
